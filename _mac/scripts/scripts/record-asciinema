#!/usr/bin/env bash
# record-asciinema — Record a terminal session from a screenplay script.
#
# Usage:
#   record-asciinema <screenplay.sh> [output.cast] [options]
#   record-asciinema <screenplay.sh> demo.cast --cols 160 --rows 40
#   record-asciinema <screenplay.sh> demo.cast --ps1 '\w $ '
#
# Options (after positional args):
#   --cols N        recording terminal width  (default: 120)
#   --rows N        recording terminal height (default: 30)
#   --char-delay N  seconds between keystrokes (default: 0.04)
#   --no-jitter     use a fixed delay per keystroke instead of randomised timing
#   --context N     screenplay lines shown above/below current line (default: 4)
#                   viewer pane height is derived: N×2 + 5
#   --ps1 PROMPT    override the PS1 shown in the recording
#                   (default: green dirname + yellow git branch)
#                   Example values:
#                     --ps1 '\w $ '               plain path + dollar
#                     --ps1 '→ '                  minimal arrow
#                     --ps1 '\[\e[36m\]\W\[\e[0m\] % '  cyan dirname + percent
#   --dir PATH      starting directory for the recording shell (default: current dir)
#   --transcript F  save a plain-text transcript of the recording to F
#
# The tool automatically attaches to a tmux session showing:
#   top pane    — the driven shell (exactly what asciinema records)
#   bottom pane — screenplay viewer with progress bar and highlighted current line
#
# Tmux chrome and the bottom pane are NOT in the recording.
#
# ── Screenplay API ────────────────────────────────────────────────────────────
#
# Screenplays are plain bash scripts — variables, loops, and conditionals all
# work. The functions below are available as regular bash functions:
#
#   run "command"        type the command char-by-char, then press Enter
#   type_text "text"     type text char-by-char (no Enter)
#   enter                press Enter
#   ctrl_c               send Ctrl-C
#   pause [seconds]      wait (default: 1s)
#   clear_screen         send clear + Enter
#   blank_lines [n]      press Enter n times (default: 1)
#   stop_recording       end the recording early and save
#   pause_recording      mute all shell commands until continue_recording
#   continue_recording   resume sending commands to the shell
#
# Requirements: tmux, asciinema
#
set -euo pipefail

# ── Dependency check ──────────────────────────────────────────────────────────

for _dep in tmux asciinema; do
    command -v "$_dep" >/dev/null 2>&1 || {
        echo "record-asciinema: '$_dep' not found — please install it first" >&2
        exit 1
    }
done
unset _dep

# ── Error handling ────────────────────────────────────────────────────────────

SESSION=""
RCFILE=""
HELPER_SCRIPT=""
PROGRESS_FILE=""
PAUSE_FILE=""
PROCESSED=""
VIEWER_SCRIPT=""

_cleanup() {
    local code=$?
    [[ -n "$SESSION"       ]] && tmux kill-session -t "$SESSION" 2>/dev/null || true
    [[ -n "$RCFILE"        ]] && rm -f "$RCFILE"
    [[ -n "$HELPER_SCRIPT" ]] && rm -f "$HELPER_SCRIPT"
    [[ -n "$PROGRESS_FILE" ]] && rm -f "$PROGRESS_FILE"
    [[ -n "$PAUSE_FILE"    ]] && rm -f "$PAUSE_FILE"
    [[ -n "$PROCESSED"     ]] && rm -f "$PROCESSED"
    [[ -n "$VIEWER_SCRIPT" ]] && rm -f "$VIEWER_SCRIPT"
    [[ $code -ne 0         ]] && echo "record-asciinema: aborted (exit $code)" >&2 || true
}
trap '_cleanup' EXIT

_err() {
    echo "record-asciinema: error at line ${BASH_LINENO[0]}: $BASH_COMMAND" >&2
}
trap '_err' ERR

# ── Argument parsing ──────────────────────────────────────────────────────────

SCREENPLAY="${1:?Usage: record-asciinema <screenplay.sh> [output.cast] [--cols N] [--rows N] [--char-delay N] [--ps1 PROMPT]}"
OUTPUT="${2:-demo.cast}"

# Handle --help before the positional shift so it works with no other args.
for arg in "$@"; do
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        awk '/^set -/{exit} NR>1{sub(/^# ?/,""); print}' "$0"
        trap - ERR EXIT
        exit 0
    fi
done

shift 2 2>/dev/null || shift 1

COLS=120
ROWS=30
CHAR_DELAY=0.04
JITTER=1
CONTEXT=4
CUSTOM_PS1=""
START_DIR=""
TRANSCRIPT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --cols)       COLS="$2";       shift 2 ;;
        --rows)       ROWS="$2";       shift 2 ;;
        --char-delay) CHAR_DELAY="$2"; shift 2 ;;
        --no-jitter)  JITTER=0;        shift   ;;
        --context)    CONTEXT="$2";    shift 2 ;;
        --ps1)        CUSTOM_PS1="$2"; shift 2 ;;
        --dir)        START_DIR="$2";    shift 2 ;;
        --transcript) TRANSCRIPT="$2";  shift 2 ;;
        --help|-h)    awk '/^set -/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; trap - ERR EXIT; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# ── Validate screenplay exists ────────────────────────────────────────────────

[[ -f "$SCREENPLAY" ]] || {
    echo "record-asciinema: screenplay not found: $SCREENPLAY" >&2
    exit 1
}

# ── If the output file already exists, append epoch to avoid overwriting ──────

if [[ -e "$OUTPUT" ]]; then
    base="${OUTPUT%.*}"
    ext="${OUTPUT##*.}"
    # Handle extensionless filenames (no dot → ext equals the full name).
    if [[ "$ext" == "$OUTPUT" ]]; then
        OUTPUT="${OUTPUT}-$(date +%s)"
    else
        OUTPUT="${base}-$(date +%s).${ext}"
    fi
    echo "Output file already exists — saving to: $OUTPUT" >&2
fi

SESSION="asciinema-rec-$$"

# Resolve screenplay to absolute path so it works from any tmux pane cwd.
SCREENPLAY_ABS="$(cd "$(dirname "$SCREENPLAY")" && pwd)/$(basename "$SCREENPLAY")"

# If --dir was not passed, check whether the screenplay declares RECORDING_DIR.
# Source the screenplay in a subshell with all API calls stubbed out so variable
# references (e.g. $COURSE_ROOT) expand naturally without running any commands.
if [[ -z "$START_DIR" ]]; then
    _declared=$(bash 2>/dev/null -c '
        run() { :; }; type_text() { :; }; enter() { :; }; ctrl_c() { :; }
        pause() { :; }; clear_screen() { :; }; blank_lines() { :; }
        pause_recording() { :; }; continue_recording() { :; }; stop_recording() { exit 0; }
        trap '"'"'echo "$RECORDING_DIR"'"'"' EXIT
        source "$1"
    ' _ "$SCREENPLAY_ABS")
    [[ -n "$_declared" ]] && START_DIR="$_declared"
    unset _declared
fi

# ── Screenplay functions ──────────────────────────────────────────────────────

_TARGET=""
PROGRESS_FILE=$(mktemp /tmp/asciinema-prog-XXXXXX)
echo "0" > "$PROGRESS_FILE"
PAUSE_FILE=$(mktemp /tmp/asciinema-pause-XXXXXX)
rm -f "$PAUSE_FILE"   # absent = recording active

# ── Screenplay helper (isolated in its own file, sourced by the screenplay) ───
# Functions use env vars so they work in a fresh bash process:
#   _REC_TARGET        — tmux pane ID for send-keys
#   _REC_PROGRESS_FILE — path to the step counter file
#   _REC_PAUSE_FILE    — path to the pause flag file (exists = paused)
#   _REC_CHAR_DELAY    — seconds between keystrokes
#   _REC_JITTER        — 1 = randomised timing (default), 0 = fixed delay
#   _REC_COLS          — recording terminal width
#   _REC_ROWS          — recording terminal height

HELPER_SCRIPT=$(mktemp /tmp/asciinema-helper-XXXXXX.sh)
cat > "$HELPER_SCRIPT" << 'HELPER_EOF'
_rec_paused() { [[ -f "$_REC_PAUSE_FILE" ]]; }

type_text() {
    _rec_paused && return
    local text="$1" i ch delay_ms
    local base_ms
    base_ms=$(awk "BEGIN{print int($_REC_CHAR_DELAY * 1000)}")
    if [[ "$_REC_JITTER" == "1" ]]; then
        local spread jitter
        spread=$(( base_ms * 3 / 4 ))
        [[ $spread -lt 1 ]] && spread=1
    fi
    for ((i = 0; i < ${#text}; i++)); do
        ch="${text:$i:1}"
        tmux send-keys -t "$_REC_TARGET" -l "$ch"
        if [[ "$_REC_JITTER" == "1" ]]; then
            jitter=$(( (RANDOM % (spread * 2 + 1)) - spread ))
            delay_ms=$(( base_ms + jitter ))
            [[ "$ch" == " " ]] && delay_ms=$(( delay_ms + RANDOM % 60 ))
            [[ $delay_ms -lt 10  ]] && delay_ms=10
            [[ $delay_ms -gt 999 ]] && delay_ms=999
            sleep "0.$(printf '%03d' $delay_ms)"
        else
            sleep "$_REC_CHAR_DELAY"
        fi
    done
}
run()         { _rec_paused && return; type_text "$1"; sleep 0.3; tmux send-keys -t "$_REC_TARGET" Enter; sleep 0.3; }
enter()       { _rec_paused && return; tmux send-keys -t "$_REC_TARGET" Enter; }
ctrl_c()      { _rec_paused && return; tmux send-keys -t "$_REC_TARGET" C-c; sleep 0.3; }
pause()       { sleep "${1:-1}"; }
clear_screen(){ _rec_paused && return; tmux send-keys -t "$_REC_TARGET" "clear" Enter; sleep 0.5; }
blank_lines() {
    _rec_paused && return
    local n="${1:-1}" i
    for ((i = 0; i < n; i++)); do tmux send-keys -t "$_REC_TARGET" Enter; done
    sleep 0.2
}
_prog_line()       { echo "$1" > "$_REC_PROGRESS_FILE"; }
stop_recording()   { exit 0; }
pause_recording()  { touch "$_REC_PAUSE_FILE"; }
continue_recording(){ rm -f "$_REC_PAUSE_FILE"; }
HELPER_EOF

# ── Pre-process screenplay: inject _prog_line N before each action ────────────

PROCESSED=$(mktemp /tmp/asciinema-proc-XXXXXX.sh)
TOTAL_ACTIONS=0
_lineno=0

# Prepend the helper source so the screenplay process has the API functions.
printf '. "%s"\n' "$HELPER_SCRIPT" > "$PROCESSED"

while IFS= read -r _line || [[ -n "$_line" ]]; do
    _lineno=$((_lineno + 1))
    _stripped="${_line#"${_line%%[![:space:]]*}"}"   # left-trim whitespace
    if [[ -n "$_stripped" && "${_stripped:0:1}" != '#' ]]; then
        TOTAL_ACTIONS=$((TOTAL_ACTIONS + 1))
        printf '_prog_line %d\n' "$TOTAL_ACTIONS"
    fi
    printf '%s\n' "$_line"
done < "$SCREENPLAY_ABS" >> "$PROCESSED"

# ── Recording shell RC ────────────────────────────────────────────────────────

RCFILE=$(mktemp /tmp/asciinema-rc-XXXXXX.sh)

# Build the PS1 to use in the recording shell.
# --ps1 overrides the default; single-quotes are preserved as-is.
if [[ -n "$CUSTOM_PS1" ]]; then
    _PS1_EXPR="export PS1='${CUSTOM_PS1}'"
else
    _PS1_EXPR="export PS1='\[\e[0;32m\]\W\[\e[0;33m\]\$(_git_branch)\[\e[0m\]\$ '"
fi

cat > "$RCFILE" << RCEOF
export HISTFILE=/dev/null HISTSIZE=0
_git_branch() { git -C . rev-parse --abbrev-ref HEAD 2>/dev/null | sed 's/.*/ (&)/'; }
${_PS1_EXPR}
[ -f /etc/profile ] && source /etc/profile 2>/dev/null || true
[ -f ~/.profile   ] && source ~/.profile   2>/dev/null || true
[ -f ~/.bashrc    ] && source ~/.bashrc    2>/dev/null || true
${_PS1_EXPR}
# Override PROMPT_COMMAND last so the pane title stays 'recording'
# regardless of what the user's bashrc set it to.
PROMPT_COMMAND='echo -ne "\033]2;recording\007"'
${START_DIR:+cd '${START_DIR}'}
RCEOF

# ── Viewer script (runs in the bottom tmux pane) ──────────────────────────────
# Variables are expanded now (heredoc without quotes) so the viewer gets
# hardcoded paths and counts. Bash vars inside the viewer use \$ to escape.

VIEWER_SCRIPT=$(mktemp /tmp/asciinema-viewer-XXXXXX.sh)
chmod +x "$VIEWER_SCRIPT"
cat > "$VIEWER_SCRIPT" << VIEWER_EOF
#!/usr/bin/env bash
SCREENPLAY_ABS="$SCREENPLAY_ABS"
PROGRESS_FILE="$PROGRESS_FILE"
PAUSE_FILE="$PAUSE_FILE"
TOTAL_ACTIONS=$TOTAL_ACTIONS
RECORDING_PANE="$SESSION:0.0"
SESSION_NAME="$SESSION"

# Set the pane title immediately so it isn't overridden by the shell's PROMPT_COMMAND.
echo -ne "\033]2;progress - $(basename "$OUTPUT")\007"

mapfile -t SCREENPLAY_LINES < "\$SCREENPLAY_ABS"
TOTAL_SOURCE_LINES=\${#SCREENPLAY_LINES[@]}

_find_source_line() {
    # Returns the 1-based source line for the Nth non-blank non-comment line.
    local target_action=\$1
    local action_num=0
    for ((i = 0; i < TOTAL_SOURCE_LINES; i++)); do
        local line="\${SCREENPLAY_LINES[i]}"
        local stripped="\${line#"\${line%%[![:space:]]*}"}"
        if [[ -n "\$stripped" && "\${stripped:0:1}" != '#' ]]; then
            action_num=\$((action_num + 1))
            [[ \$action_num -eq \$target_action ]] && { echo \$((i + 1)); return; }
        fi
    done
    echo 0
}

_draw_bar() {
    local step=\$1 total=\$2 width=40
    local filled=0 empty=\$width pct=0
    if [[ \$total -gt 0 ]]; then
        filled=\$((step * width / total))
        [[ \$filled -gt \$width ]] && filled=\$width
        empty=\$((width - filled))
        pct=\$((step * 100 / total))
    fi
    printf '  ['
    local i
    for ((i = 0; i < filled; i++)); do printf '\033[32m█\033[0m'; done
    for ((i = 0; i < empty;  i++)); do printf '\033[90m░\033[0m'; done
    if [[ -f "$PAUSE_FILE" ]]; then
        printf '] \033[1m%d%%\033[0m  \033[1;33m[PAUSED]\033[0m\n' "\$pct"
    else
        printf '] \033[1m%d%%\033[0m\n' "\$pct"
    fi
}

prev_step=-1
prev_paused=-1
while true; do
    # Poll for a keypress (0.1 s timeout doubles as the loop cadence).
    read -t 0.1 -n 1 -s key 2>/dev/null
    case "\$key" in
        q|Q)
            tmux send-keys -t "\$RECORDING_PANE" "" "C-d"
            sleep 2
            tmux kill-session -t "\$SESSION_NAME" 2>/dev/null
            exit 0 ;;
        p|P|' ')
            if [[ -f "$PAUSE_FILE" ]]; then
                rm -f "$PAUSE_FILE"
            else
                touch "$PAUSE_FILE"
            fi ;;
    esac

    step=\$(cat "\$PROGRESS_FILE" 2>/dev/null || echo "0")
    step=\${step:-0}
    paused=\$([[ -f "$PAUSE_FILE" ]] && echo 1 || echo 0)

    [[ \$step -eq \$prev_step && \$paused -eq \$prev_paused ]] && continue
    prev_step=\$step
    prev_paused=\$paused

    current_line=\$(_find_source_line "\$step")

    printf '\033[2J\033[H'   # clear + cursor home
    printf '\033[1;36m  %s\033[0m  →  \033[1;33m%s\033[0m  %d / %d\n' "\$(basename "\$SCREENPLAY_ABS")" "$(basename "$OUTPUT")" "\$step" "\$TOTAL_ACTIONS"
    _draw_bar "\$step" "\$TOTAL_ACTIONS"
    printf '\n'

    # Fixed window: always render exactly win×2+1 lines.
    # Lines outside the file are rendered as blank rows so the layout never shifts.
    win=$CONTEXT
    for (( offset = -win; offset <= win; offset++ )); do
        lineno=\$((current_line + offset))
        if [[ \$lineno -lt 1 || \$lineno -gt TOTAL_SOURCE_LINES ]]; then
            printf '\n'
        else
            i=\$((lineno - 1))
            line="\${SCREENPLAY_LINES[i]:-}"
            if [[ \$offset -eq 0 ]]; then
                printf '  \033[1;32m►%3d  %s\033[0m\n' "\$lineno" "\$line"
            else
                printf '   %3d  \033[90m%s\033[0m\n'   "\$lineno" "\$line"
            fi
        fi
    done

    printf '\033[90m  [q] stop   [p] pause/resume\033[0m\n'
done
VIEWER_EOF

# ── Tmux session layout ───────────────────────────────────────────────────────
# Total session height = recording rows + viewer pane + split divider line.

# Viewer pane height: 3 header lines + (CONTEXT×2 + 1) screenplay lines + 1 scroll buffer.
VIEWER_ROWS=$(( CONTEXT * 2 + 6 ))
TOTAL_ROWS=$((ROWS + VIEWER_ROWS + 1))

tmux new-session -d -s "$SESSION" -x "$COLS" -y "$TOTAL_ROWS"

# Hide the tmux status bar — the viewer pane handles all status display.
tmux set-option -t "$SESSION" status off

# Split the window: top = recording pane (ROWS tall), bottom = viewer (VIEWER_ROWS tall).
# tmux split-window -l specifies the size of the NEW pane (bottom), leaving the top as-is.
tmux split-window -v -l "$VIEWER_ROWS" -t "$SESSION:0.0"

# Name the panes so they show meaningful titles in the pane border.
tmux select-pane -t "$SESSION:0.0" -T "recording"
tmux select-pane -t "$SESSION:0.1" -T "progress - $(basename "$OUTPUT")"

_TARGET="$SESSION:0.0"

# Clear the pane before starting asciinema so the previous prompt and the
# exec line are not visible when the session is attached.
tmux send-keys -t "$SESSION:0.0" "clear" Enter
sleep 0.1

# Start asciinema in the top pane.
# `exec` replaces the pane shell so the invocation line never appears in the recording.
tmux send-keys -t "$SESSION:0.0" \
    "exec asciinema rec --window-size ${COLS}x${ROWS} -q '$OUTPUT' --command 'bash --rcfile $RCFILE'" \
    Enter

# Start the viewer in the bottom pane; clear first so the launch command doesn't linger.
tmux send-keys -t "$SESSION:0.1" "clear && bash '$VIEWER_SCRIPT'; exit" Enter

# ── Screenplay runner (background) + tmux attach (foreground) ────────────────

echo "record-asciinema"
echo "  screenplay : $SCREENPLAY"
echo "  output     : $OUTPUT"
echo "  terminal   : ${COLS}x${ROWS}  (+ ${VIEWER_ROWS} row viewer)"
echo ""

(
    sleep 2                    # wait for asciinema to start the recording shell
    # Run the screenplay in a fresh bash process — no main-script functions
    # or variables leak into it. All API functions are sourced from HELPER_SCRIPT.
    _REC_TARGET="$_TARGET" \
    _REC_PROGRESS_FILE="$PROGRESS_FILE" \
    _REC_PAUSE_FILE="$PAUSE_FILE" \
    _REC_CHAR_DELAY="$CHAR_DELAY" \
    _REC_JITTER="$JITTER" \
    _REC_COLS="$COLS" \
    _REC_ROWS="$ROWS" \
    bash "$PROCESSED"
    sleep 1                    # let the last command's output settle
    tmux send-keys -t "$SESSION:0.0" "" "C-d"   # EOF → stop asciinema
    sleep 2                    # wait for asciinema to flush and write the file
    tmux kill-session -t "$SESSION" 2>/dev/null || true
) &
RUNNER_PID=$!

# Lock the tmux window to the exact session dimensions so attaching clients
# cannot shrink or expand it — prevents hatching and guarantees the recording
# pane is COLS×ROWS regardless of the client terminal size.
tmux set-option -t "$SESSION" window-size manual
tmux resize-window -t "$SESSION" -x "$COLS" -y "$TOTAL_ROWS"

# Select the recording pane as active so its cursor is visible on attach.
tmux select-pane -t "$SESSION:0.0"

# Attach to the session (blocks until the session is killed by the runner above).
tmux attach-session -t "$SESSION" || true

# Wait for the runner to finish; ignore its exit code — the runner kills the
# tmux session which makes tmux kill-session itself exit non-zero when the
# session is already gone, and that propagates through wait.
wait "$RUNNER_PID" || true

# Disable the ERR trap now — cleanup is done, remaining lines must not be
# misidentified as errors.
trap - ERR

echo ""
echo "Saved: $OUTPUT"

if [[ -n "$TRANSCRIPT" ]]; then
    python3 - "$OUTPUT" "$TRANSCRIPT" << 'PYEOF'
import sys, json, re

cast, out = sys.argv[1], sys.argv[2]
ansi = re.compile(r'\x1b(?:\[[0-9;]*[A-Za-z]|[^[])')

with open(cast) as f, open(out, 'w') as t:
    next(f)  # skip header line
    for line in f:
        try:
            _, kind, data = json.loads(line)
            if kind == 'o':
                t.write(ansi.sub('', data))
        except (json.JSONDecodeError, ValueError):
            pass
PYEOF
    echo "Transcript: $TRANSCRIPT"
fi
echo ""
echo "Play back with:"
echo "  asciinema play '$OUTPUT'"
