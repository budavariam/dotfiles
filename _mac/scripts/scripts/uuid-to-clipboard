#!/usr/bin/env bash
# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Copy Random UUID
# @raycast.mode silent

# Optional parameters:
# @raycast.icon 🎲
# @raycast.packageName Utilities

uuid=$(uuidgen | tr '[:upper:]' '[:lower:]')
echo -n "$uuid" | pbcopy
echo "UUID $uuid copied to clipboard"
